node_modules/

# Per-project generated images (large, regenerable from prompt packs)
projects/*/outputs/candidates/
projects/*/outputs/approved/
projects/*/outputs/rejected/
projects/*/outputs/borderline/
projects/*/outputs/painterly/
projects/*/outputs/painterly-test/
projects/*/exports/
projects/*/snapshots/
projects/*/splits/
projects/*/dataset-cards/
projects/*/eval-packs/
# Training packages copy the curated images (large, regenerable from the
# tracked manifest + records via `sdlab training-package build`)
projects/*/training/packages/

# Python cache (scripts/qwen_generate.py runs)
__pycache__/

# Canon-build generated output + cache (regenerable from canon entries).
# config.json is tracked; build output directories are not.
projects/*/canon-build/*/
projects/*/canon-build/.cache/

# Model weights (never commit)
*.safetensors
*.ckpt
*.pth
*.bin

# Misc
*.tmp
*.zip
*.log
.polyglot-cache.json
.DS_Store

# Site build
site/.astro/
site/dist/
site/node_modules/

# Test coverage output
coverage/
.nyc_output/

# Generated candidate images — ignore at ANY depth.
# (Was projects/*/outputs/*/*.png — only 2-level; missed outputs/v3/<subject>/ etc.)
projects/*/outputs/**/*.png
projects/*/outputs/**/*.jpg
projects/*/outputs/**/*.jpeg
projects/*/outputs/**/*.webp

# Reference plates are pinned visual receipts, not regenerable candidates: a
# record that cites a plate is worthless if the plate is not in the repo. Any
# `outputs/*-ref/` directory is therefore un-ignored. Added 2026-08-22 after
# the ferrochrome removal, where the rule above had silently kept a whole
# session of generated plates OUT of git while the commits that described them
# went in -- so "it is committed" was true of the records and false of the
# pixels.
!projects/*/outputs/*-ref/
!projects/*/outputs/*-ref/*.png

# Re-ingest staging images. `sdlab init` CREATES inbox/generated/ and
# `reingest-selected` COPIES production images into it — so this directory
# fills with blobs by design. It was uncovered until 2026-08-03, when 55 MB
# of salt-road PNGs turned up staged for commit. The receipts and record
# JSON alongside them ARE tracked; only the pixels are ignored.
projects/*/inbox/**/*.png
projects/*/inbox/**/*.jpg
projects/*/inbox/**/*.jpeg
projects/*/inbox/**/*.webp

# Contact sheets are a review surface regenerated from the images and records
# they describe — `sdlab sheet` rebuilds one in seconds. Same reasoning as the
# inbox rule above: the artifacts are tracked, the rendering of them is not.
projects/*/outputs/sheets/

# Editor/scratch backups
*.bak

# Blender module renders + saved scenes (regenerable from the module .py sources)
projects/*/inputs/blender/out/
