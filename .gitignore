node_modules/

# Per-project generated images (large, regenerable from prompt packs)
projects/*/outputs/candidates/
projects/*/outputs/approved/
projects/*/outputs/rejected/
projects/*/outputs/borderline/
projects/*/outputs/painterly/
projects/*/outputs/painterly-test/
projects/*/exports/
projects/*/snapshots/
projects/*/splits/
projects/*/dataset-cards/
projects/*/eval-packs/
# Training packages copy the curated images (large, regenerable from the
# tracked manifest + records via `sdlab training-package build`)
projects/*/training/packages/

# Python cache (scripts/qwen_generate.py runs)
__pycache__/

# Canon-build generated output + cache (regenerable from canon entries).
# config.json is tracked; build output directories are not.
projects/*/canon-build/*/
projects/*/canon-build/.cache/

# Model weights (never commit)
*.safetensors
*.ckpt
*.pth
*.bin

# Misc
*.tmp
*.zip
*.log
.polyglot-cache.json
.DS_Store

# Site build
site/.astro/
site/dist/
site/node_modules/

# Test coverage output
coverage/
.nyc_output/

# Generated candidate images — ignore at ANY depth.
# (Was projects/*/outputs/*/*.png — only 2-level; missed outputs/v3/<subject>/ etc.)
projects/*/outputs/**/*.png
projects/*/outputs/**/*.jpg
projects/*/outputs/**/*.jpeg
projects/*/outputs/**/*.webp

# Blender module renders + saved scenes (regenerable from the module .py sources)
projects/*/inputs/blender/out/
