# Generated by `sdlab init` — regenerable blobs for this project.
# Records/config JSON are tracked; only pixels and derived artifacts are not.

inbox/**/*.png
inbox/**/*.jpg
inbox/**/*.jpeg
inbox/**/*.webp
outputs/**
exports/
snapshots/
splits/
canon-build/*/

# Asset-lane binaries: every one is pinned by sha256 in the asset's
# ingest-receipt.json and regenerable from the source export. The manifest
# copy and the receipt (JSON) stay tracked.
assets/*/masks/
assets/*/channels/
assets/*/pairs/
assets/*/loss-masks/
