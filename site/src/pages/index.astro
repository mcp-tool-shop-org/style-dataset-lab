---
import '../styles/global.css';
import SiteLayout from '../layouts/SiteLayout.astro';
import Section from '@mcptoolshop/site-theme/components/Section.astro';
import FeatureGrid from '@mcptoolshop/site-theme/components/FeatureGrid.astro';
import DataTable from '@mcptoolshop/site-theme/components/DataTable.astro';
import CodeCardGrid from '@mcptoolshop/site-theme/components/CodeCardGrid.astro';
import ApiList from '@mcptoolshop/site-theme/components/ApiList.astro';
import { config } from '../site-config';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const handbookHref = `${base}handbook/`;
const tallowFenHref = `${base}handbook/case-study-tallow-fen/`;
const rustlineHref = `${base}handbook/case-study-rustline/`;
const installCmd = 'npm install -g @mcptoolshop/style-dataset-lab';
const ogUrl = 'https://mcp-tool-shop-org.github.io/style-dataset-lab/';
// No OG image asset is shipped yet — leave undefined so scrapers fall back to
// the summary card. Swap in a 1200x630 /og.png under site/public/ when one lands.
const ogImage: string | undefined = undefined;
---

<SiteLayout
  title={config.title}
  description={config.description}
  logoBadge={config.logoBadge}
  brandName={config.brandName}
  repoUrl={config.repoUrl}
  npmUrl={config.npmUrl}
  footerText={config.footerText}
  nav={[{ href: '#proven', label: 'Proven in production' }, ...config.sections.map(s => ({ href: `#${s.id}`, label: s.title }))]}
  ogUrl={ogUrl}
  ogImage={ogImage}
>
  <section class="py-14 md:py-20">
    <div class="mb-4">
      <span class="inline-flex items-center rounded-full border border-edge px-3 py-1 text-xs font-medium text-muted">
        {config.hero.badge}
      </span>
    </div>
    <h1 class="text-4xl font-bold tracking-tight text-heading md:text-5xl">
      {config.hero.headline}
    </h1>
    <p class="mt-3 max-w-3xl text-xl text-body md:text-2xl" role="doc-subtitle">
      {config.hero.headlineAccent}
    </p>
    <p class="mt-6 max-w-3xl text-base text-muted md:text-lg">
      {config.hero.description}
    </p>

    <div class="mt-8 max-w-3xl">
      <label class="mb-2 block text-xs font-medium uppercase tracking-wide text-muted" for="install-cmd">
        Install
      </label>
      <div class="flex items-stretch gap-2 rounded-xl border border-edge bg-surface-raised p-1">
        <code
          id="install-cmd"
          class="flex-1 overflow-x-auto whitespace-nowrap rounded-lg bg-surface px-3 py-2 font-mono text-sm text-body"
        >{installCmd}</code>
        <button
          type="button"
          id="copy-install"
          class="shrink-0 rounded-lg bg-action px-4 py-2 text-sm font-medium text-action-text hover:bg-action-hover"
          data-copy={installCmd}
          aria-label="Copy install command"
        >
          Copy
        </button>
      </div>
      <p class="mt-3 text-sm text-muted">
        Requires Node 18+. After install, run <code class="font-mono text-body">sdlab init my-project --domain character-design</code>.
      </p>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      <a
        href={handbookHref}
        class="inline-flex rounded-xl border border-edge px-4 py-2 text-sm text-body hover:bg-surface-raised"
      >
        Read the handbook →
      </a>
      <a
        href="#how-it-works"
        class="inline-flex text-sm text-muted hover:text-heading"
      >
        See how it works
      </a>
    </div>
  </section>

  <!-- Proven in production — market proof: two real style-LoRAs shipped end-to-end through this pipeline. -->
  <section id="proven" class="border-t border-edge py-14 md:py-20">
    <div class="mb-3">
      <span class="inline-flex items-center rounded-full border border-edge px-3 py-1 text-xs font-medium text-muted">
        Proven in production
      </span>
    </div>
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">
      Two real style-LoRAs shipped through this pipeline
    </h2>
    <p class="mt-3 max-w-3xl text-base text-muted md:text-lg">
      The same pipeline shipped a coherent style through a brutal, high-rejection exploratory
      creature run <span class="text-body">and</span> a converged, high-yield concept run. Two
      different production profiles, one pipeline, two shipped LoRAs — with real curation numbers
      you can inspect in the repo.
    </p>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <div class="rounded-xl border border-edge bg-surface-raised p-6">
        <div class="flex items-baseline justify-between gap-3">
          <h3 class="text-lg font-semibold text-heading">Tallow Fen</h3>
          <span class="shrink-0 text-xs font-medium uppercase tracking-wide text-muted">creature-design</span>
        </div>
        <p class="mt-2 text-sm text-muted">
          A from-scratch bestiary canon and an honest curation gate — 169 rejections against 99 approvals.
          The gate that can reject hard.
        </p>
        <dl class="mt-5 grid grid-cols-3 gap-3 text-center">
          <div>
            <dd class="text-2xl font-bold text-heading">293</dd>
            <dt class="mt-1 text-xs text-muted">records</dt>
          </div>
          <div>
            <dd class="text-2xl font-bold text-heading">~34%</dd>
            <dt class="mt-1 text-xs text-muted">approval rate</dt>
          </div>
          <div>
            <dd class="text-2xl font-bold text-heading">25</dd>
            <dt class="mt-1 text-xs text-muted">provenance waves</dt>
          </div>
        </dl>
        <p class="mt-5 text-xs text-muted">
          Shipped style
          <code class="font-mono text-body">tallow_fen_style_v3.safetensors</code> @ 1.5 · base
          <code class="font-mono text-body">qwen-image</code>
        </p>
        <a href={tallowFenHref} class="mt-4 inline-flex text-sm font-medium text-body hover:text-heading">
          Read the case study →
        </a>
      </div>

      <div class="rounded-xl border border-edge bg-surface-raised p-6">
        <div class="flex items-baseline justify-between gap-3">
          <h3 class="text-lg font-semibold text-heading">Rustline</h3>
          <span class="shrink-0 text-xs font-medium uppercase tracking-wide text-muted">concept-design</span>
        </div>
        <p class="mt-2 text-sm text-muted">
          Dense, pre-formed canon and a converged run — 172 approvals against 8 rejections. Reused
          downstream by a second project.
        </p>
        <dl class="mt-5 grid grid-cols-3 gap-3 text-center">
          <div>
            <dd class="text-2xl font-bold text-heading">180</dd>
            <dt class="mt-1 text-xs text-muted">records</dt>
          </div>
          <div>
            <dd class="text-2xl font-bold text-heading">~96%</dd>
            <dt class="mt-1 text-xs text-muted">approval rate</dt>
          </div>
          <div>
            <dd class="text-2xl font-bold text-heading">46</dd>
            <dt class="mt-1 text-xs text-muted">provenance waves</dt>
          </div>
        </dl>
        <p class="mt-5 text-xs text-muted">
          Shipped style
          <code class="font-mono text-body">rustline_v3ckpt_1500.safetensors</code> @ 1.0 · base
          <code class="font-mono text-body">qwen-image</code>
        </p>
        <a href={rustlineHref} class="mt-4 inline-flex text-sm font-medium text-body hover:text-heading">
          Read the case study →
        </a>
      </div>
    </div>
  </section>

  {config.sections.map((s) => (
    <Section id={s.id} title={s.title} subtitle={s.subtitle}>
      {s.kind === 'features' && <FeatureGrid features={s.features} />}
      {s.kind === 'data-table' && <DataTable columns={s.columns} rows={s.rows} />}
      {s.kind === 'code-cards' && <CodeCardGrid cards={s.cards} />}
      {s.kind === 'api' && <ApiList apis={s.apis} />}
    </Section>
  ))}

  <script is:inline>
    (function () {
      var btn = document.getElementById('copy-install');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var text = btn.getAttribute('data-copy') || '';
        var original = btn.textContent;
        var done = function () {
          btn.textContent = 'Copied';
          setTimeout(function () { btn.textContent = original; }, 1600);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done, done);
        } else {
          var ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch (e) {}
          document.body.removeChild(ta);
          done();
        }
      });
    })();
  </script>
</SiteLayout>
